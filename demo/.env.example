# LLM API Keys (required for demo)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Observability Endpoints (defaults work with Docker Compose)
# Note: The exporter automatically appends /v1/traces to these endpoints
ARIZE_PHOENIX_OTLP_ENDPOINT=http://localhost:6006
JAEGER_OTLP_ENDPOINT=http://localhost:4318

# Service Configuration
OTEL_SERVICE_NAME=agent_obs_demo
OTEL_RESOURCE_ATTRIBUTES=service.name=agent_obs_demo,deployment.environment=local

# Demo Configuration
DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514
